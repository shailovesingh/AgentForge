      { "id": "l2", "type": "llm.prompt", "typeVersion": 1, "label": "Long", "config": { "provider": "ollama", "prompt": "Summarize in a paragraph." }, "position": { "x": 200, "y": 100 } },
      { "id": "o1", "type": "output.result", "typeVersion": 1, "label": "Short result", "config": { "format": "text" }, "position": { "x": 400, "y": -100 } },
