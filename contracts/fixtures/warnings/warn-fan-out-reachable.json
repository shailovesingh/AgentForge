{
  "name": "warn-fan-out-reachable",
  "description": "One trigger output fanned out to two branches reaches both of them: no warnings.",
  "workflow": {
    "schemaVersion": "1.0",
    "id": "wf_1",
    "name": "Fan out",
    "description": "",
    "nodes": [
      { "id": "t", "type": "trigger.manual", "typeVersion": 1, "label": "Start", "config": { "payload": {} }, "position": { "x": 0, "y": 0 } },
