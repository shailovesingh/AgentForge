{
  "name": "sch-object-required-multiple",
  "description": "Several absent required keys are each reported (compared as a multiset; the order of the errors is not part of the contract).",
  "schema": {
    "type": "object",
    "properties": {
      "a": {
        "type": "string"
      },
      "b": {
        "type": "string"
      }
    },
    "required": [
      "b",
      "a"
    ]
  },
  "value": {},
  "options": {
    "checkRequired": true
  },
  "expect": [
    {
      "code": "schema.required",
      "path": "/a"
    },
    {
      "code": "schema.required",
      "path": "/b"
    }
  ]
}
